# Tuya OpenAPI credentials. Copy to the repo ROOT as .env (not tuya/.env --
# export.ipynb does load_dotenv("../.env"), one level up from this directory)
# and fill in your values. See MIGRATION.md's "Repeating this in N years"
# section for the full account/console setup this assumes.

# Required by export.ipynb (the Tuya cloud export notebook) --
# Tuya IoT Platform -> Cloud -> Development -> your project -> Overview
TUYA_ACCESS_ID=YOUR_ACCESS_ID
TUYA_ACCESS_KEY=YOUR_ACCESS_SECRET_32CHARS

# Optional, export.ipynb only -- regional endpoint, defaults to EU if unset
# CN: https://openapi.tuyacn.com
# EU: https://openapi.tuyaeu.com
# US: https://openapi.tuyaus.com
# IN: https://openapi.tuyain.com
TUYA_API_ENDPOINT=https://openapi.tuyaeu.com

# Optional but strongly recommended, export.ipynb -- the real Tuya
# Smart/SmartLife APP-USER uid (not the cloud project's own service-account
# uid). Without it, homes/scenes/automations are only inferred from device
# owner_id and may come back empty. Found at: Cloud Project -> Devices ->
# Link Tuya App Account -> Users tab (after linking your app account below).
TUYA_APP_USER_UID=

# Optional, export.ipynb -- comma-separated home_id override if automatic
# home discovery doesn't find everything
TUYA_HOME_IDS=

# --- Everything below is only used by tuya_bind_device.ipynb (binding the
# ph4_tuyaopen_esp32bridge's own TuyaLink device), NOT by the local_key
# export pipeline -- irrelevant if you're only re-running export.ipynb /
# localtuya_config.ipynb. ---
TUYA_BASE_URL=https://openapi.tuyaeu.com
TUYA_DEVICE_ID=YOUR_DEVICE_UUID_20CHARS
TUYA_BIND_CODE=
TUYA_HOME_ID=
