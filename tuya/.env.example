# Tuya OpenAPI credentials
# Copy to .env and fill in your values

# From: Tuya IoT Platform → Cloud → Development → your project → Overview
TUYA_ACCESS_ID=YOUR_ACCESS_ID
TUYA_ACCESS_SECRET=YOUR_ACCESS_SECRET_32CHARS

# Regional endpoint (EU default)
# CN: https://openapi.tuyacn.com
# EU: https://openapi.tuyaeu.com
# US: https://openapi.tuyaus.com
# IN: https://openapi.tuyain.com
TUYA_BASE_URL=https://openapi.tuyaeu.com

# From: Device Management → your device
TUYA_DEVICE_ID=YOUR_DEVICE_UUID_20CHARS

# Optional: Bind Code from Device Management → your device → Bind Code column
# Leave empty to use direct-assign method (Method B)
TUYA_BIND_CODE=

# Optional: discovered automatically by the notebook if left empty
TUYA_UID=
TUYA_HOME_ID=
